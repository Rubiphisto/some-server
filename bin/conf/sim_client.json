{
  "log": {
    "file": "logs/sim_client.log",
    "error_file": "logs/sim_client.error.log",
    "level": "info",
    "console": true,
    "syslog": false,
    "rotate": {
      "mode": "size",
      "max_size": 10485760,
      "max_files": 5,
      "daily_hour": 0,
      "daily_minute": 0
    }
  },
  "sim_client": {
    "gate": {
      "host": "127.0.0.1",
      "port": 9000
    },
    "default_platform": "dev",
    "default_account_id": "sim-account-1",
    "default_client_version": 1,
    "default_channel": "sim"
  }
}
