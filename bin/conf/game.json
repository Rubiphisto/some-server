{
  "log": {
    "file": "logs/game.log",
    "error_file": "logs/game.error.log",
    "level": "info",
    "console": true,
    "syslog": false,
    "rotate": {
      "mode": "size",
      "max_size": 10485760,
      "max_files": 5,
      "daily_hour": 0,
      "daily_minute": 0
    }
  },
  "redis": {
    "default": {
      "endpoints": [
        "127.0.0.1:6379"
      ],
      "password": "",
      "database": 0,
      "key_prefix": "some_server:"
    }
  },
  "maria": {
    "default": {
      "host": "127.0.0.1",
      "port": 3306,
      "database": "some_game",
      "username": "game",
      "password": "game",
      "pool_size": 16
    }
  },
  "game": {
    "instance_id": 1,
    "listen": {
      "host": "127.0.0.1",
      "port": 9100
    },
    "discovery": {
      "endpoints": [
        "127.0.0.1:2379"
      ],
      "prefix": "/some_server/ipc/dev/local",
      "lease_ttl_seconds": 5
    },
    "storage": {
      "defaults": {
        "alive_time_seconds": 86400,
        "landing_time_seconds": 1800,
        "landing_min_time_seconds": 60
      },
      "datasets": {
        "player": {
          "redis": "default",
          "maria": "default",
          "redis_prefix": "player:",
          "table_prefix": "player_"
        }
      }
    }
  }
}
